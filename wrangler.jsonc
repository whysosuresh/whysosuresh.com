// whysosuresh.com: one Cloudflare Worker that serves the folder ./site and nothing else; no code of
// its own runs. .github/workflows/site.yaml deploys it from main with a key that reaches this one
// Worker, using the wrangler pinned in ./deploy.
//
// `routes` is the domain's whole truth: every deploy attaches exactly the domains named here and
// detaches any other, so a domain added in Cloudflare's dashboard is dropped by the next deploy.
{
  "$schema": "./deploy/node_modules/wrangler/config-schema.json",
  "name": "whysosuresh-com",
  "account_id": "@@ACCOUNT_ID@@",
  // The newest date the runtime inside the pinned wrangler supports, so `wrangler dev` runs it too.
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./site",
    // A path the site has no file for gets site/404.html, with a 404 status.
    "not_found_handling": "404-page",
    // /feedback serves feedback.html; /feedback.html and /index.html redirect to the clean address.
    "html_handling": "auto-trailing-slash"
  },
  // The apex is the Worker's one address. www stays a redirect rule in the zone, because a Worker's
  // custom domain answers only the exact name it is attached to.
  "routes": [{ "pattern": "whysosuresh.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
