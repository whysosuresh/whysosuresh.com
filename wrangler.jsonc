// whysosuresh.com: one Cloudflare Worker that serves the folder ./site and nothing else; no code of
// its own runs. This file drives `wrangler dev`, the dry run in `npm run check`, and the deploy that
// .github/workflows/site.yaml runs on every merge to main, all with the wrangler pinned in ./deploy.
//
// The zone, its records, its redirect rule and its settings are Planton's (infrastructure/); only the
// Worker and its route are declared here. Routes are declared only in this file, never in Cloudflare's
// dashboard.
{
  "$schema": "./deploy/node_modules/wrangler/config-schema.json",
  "name": "whysosuresh-com",
  "account_id": "2f1cb3191775e02873cf13bb57e9e67f",
  // The newest date the runtime inside the pinned wrangler supports, so `wrangler dev` runs it too.
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./site",
    // A path the site has no file for gets site/404.html, with a 404 status.
    "not_found_handling": "404-page",
    // /feedback serves feedback.html; /feedback.html and /index.html redirect to the clean address.
    "html_handling": "auto-trailing-slash"
  },
  // The apex is the Worker's one address, through a route on the zone, found by its name in the
  // account above. The route needs a proxied record at the apex, which Planton holds; www is the
  // zone's redirect rule, also Planton's.
  "routes": [{ "pattern": "whysosuresh.com/*", "zone_name": "whysosuresh.com" }],
  "workers_dev": false,
  "preview_urls": false
}
