// whysosuresh.com: one Cloudflare Worker that serves the folder ./site, and runs code only for /api/* (the
// note flow's one public write, src/talk.ts), /threads/* (the threads' private calls under /threads/api/,
// src/threads.ts, and the threads page at every other path, src/pages.ts, which hands over
// site/threads/index.html through the assets binding) and /me (the same page, everyone's door after sign-in),
// all on the database bound below. Every other page comes
// straight from ./site, with no code in its path, and /inbox, the threads' old address, redirects to /threads/
// (site/_redirects); Cloudflare Access guards /threads/api and everything under it (infrastructure/), never a
// thread's page. This
// file drives `wrangler dev`, the dry run in `npm run check` (whose bundle the Worker tests run, with ./site and
// the routing below), and the deploy that .github/workflows/site.yaml runs on every merge to main, all with the
// wrangler pinned in ./deploy.
//
// The zone, its records, its redirect rule and its settings, the database and the bot check are
// Planton's (infrastructure/); only the Worker, its route and its bindings are declared here. Routes
// are declared only in this file, never in Cloudflare's dashboard. The bot check's secret is not here: the
// deploy hands it over from the GitHub environment `production`, and `npm run dev` uses Cloudflare's
// public test secret. Nor is the owner's email address, which the threads admit: the deploy hands it over the
// same way, so this public repository never names it.
{
  "$schema": "./deploy/node_modules/wrangler/config-schema.json",
  "name": "whysosuresh-com",
  "account_id": "2f1cb3191775e02873cf13bb57e9e67f",
  "main": "src/worker.ts",
  // The newest date the runtime inside the pinned wrangler supports, so `wrangler dev` and the tests'
  // Miniflare (the same version wrangler uses) run it too.
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./site",
    // A path the site has no file for gets site/404.html, with a 404 status.
    "not_found_handling": "404-page",
    // /feedback serves feedback.html; /feedback.html and /index.html redirect to the clean address.
    "html_handling": "auto-trailing-slash",
    // Only these paths reach the code; everything else is a file from ./site. The rooms are the threads page too:
    // /me, the door everyone signed in enters by, /meetings, /people with a person under it, and /asks; so is an
    // ask's own address, /ask/<slug>, and his journal,
    // /journal with its days, weeks and storylines under it. The threads page's scripts live under /app/, so they stay files.
    "run_worker_first": ["/api/*", "/threads/*", "/me", "/meetings", "/people", "/people/*", "/asks", "/ask/*", "/journal", "/journal/*"],
    // How the code hands over a file from ./site: the threads page, with site/_headers on it.
    "binding": "ASSETS"
  },
  // The apex is the Worker's one address, through a route on the zone, found by its name in the
  // account above. The route needs a proxied record at the apex, which Planton holds; www is the
  // zone's redirect rule, also Planton's.
  "routes": [{ "pattern": "whysosuresh.com/*", "zone_name": "whysosuresh.com" }],
  "workers_dev": false,
  "preview_urls": false,
  // The database Planton created (Infra.prod.CloudflareD1Database.whysosuresh-com), by its
  // status.outputs.database_id. Its tables are ./migrations, which the deploy applies before the code.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whysosuresh-com",
      "database_id": "610ed990-0484-4beb-a0fd-1612479af4cc",
      "migrations_dir": "migrations"
    }
  ],
  // The pages saved into threads (Infra.prod.CloudflareR2Bucket.whysosuresh-com-pages): one private object per
  // version, read and written only by the code, which serves a page only through its thread's call, behind Access.
  "r2_buckets": [{ "binding": "PAGES", "bucket_name": "whysosuresh-com-pages" }],
  // The threads' Access application and its callers' public halves, from Planton's outputs: the team's sign-in
  // host (Infra.prod.CloudflareZeroTrustOrganization.whysosuresh, `authDomain`), the application's audience tag
  // (…AccessApplication.whysosuresh-com-threads, `status.outputs.aud`) and the recorder sync's client id
  // (…AccessServiceToken.whysosuresh-com-inbox-sync, `status.outputs.client_id`). None is secret: the Worker
  // checks that a request was signed by that team for the application in front of the door called
  // (src/access.ts).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "whysosuresh.cloudflareaccess.com",
    "THREADS_ACCESS_AUD": "db66d28750d3ed63363af7bba8a43d7aeba769eb6f7465ef9552e79917369435",
    "INBOX_SYNC_CLIENT_ID": "83ce8979a8ffde10177a8de5cdc2797d.access"
  },
  // The Worker's own log lines (one per refused send: its status and reason, nothing personal) are kept;
  // Cloudflare's automatic record of each request is off, because nothing says it leaves out the
  // visitor's address.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
